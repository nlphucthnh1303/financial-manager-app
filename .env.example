# Sao chép thành .env rồi đổi các giá trị bên dưới. KHÔNG commit file .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-nay
# Tạo bằng: openssl rand -base64 48
JWT_SECRET=
# Địa chỉ người dùng truy cập ứng dụng (dùng cho CORS)
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
# Số lần gọi đăng nhập/đăng ký/refresh tối đa mỗi phút cho một IP
AUTH_RATE_LIMIT=10
